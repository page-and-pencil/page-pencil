# ─────────────────────────────────────────────────────────────
# Worksheet Studio — 개인용 설정
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# [필수] AI 워크시트 생성 — Anthropic Claude API
# https://platform.claude.com 에서 API 키 발급
# 키가 없으면 데모 모드로 동작합니다(샘플 콘텐츠 생성).
ANTHROPIC_API_KEY=

# 생성에 사용할 모델 (기본값: claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# API 서버 포트
API_PORT=8787
